# FieldRoutes API credentials template.
# Copy this file, rename the copy to .env.import (it will be gitignored
# automatically), and fill in the real values. NEVER commit real keys.
#
# Subdomain = what you type at the FieldRoutes sign-in prompt (crescent-pest).
FIELDROUTES_SUBDOMAIN=crescent-pest
FIELDROUTES_KEY=paste-authentication-key-here
FIELDROUTES_TOKEN=paste-authentication-token-here

